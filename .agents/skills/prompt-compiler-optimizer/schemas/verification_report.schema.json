{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "VerificationReportV5",
  "title": "VerificationOutcomeV5",
  "type": "object",
  "additionalProperties": false,
  "required": ["verification_status", "assurance_level", "release_decision", "layers", "evaluation_debt", "invariant_coverage", "example_preservation_rate", "output_contract_preserved", "critical_regressions", "manual_override"],
  "properties": {
    "verification_status": { "type": "string", "enum": ["UNVERIFIED", "PARTIALLY_VERIFIED", "VERIFIED", "FAILED"] },
    "assurance_level": { "type": "string", "enum": ["UNVERIFIED", "VERIFIED_STATIC", "VERIFIED_DIFFERENTIAL", "VERIFIED_CONTRACT", "VERIFIED_MOCK", "VERIFIED_E2E"] },
    "release_decision": { "type": "string", "enum": ["RELEASED", "NEEDS_REVIEW", "BLOCKED_INSUFFICIENT_ASSURANCE", "BLOCKED_UNSUPPORTED", "FAILED", "OVERRIDE_RELEASED"] },
    "layers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["layer", "status", "scope", "reason", "evidence"],
        "properties": {
          "layer": { "type": "string" },
          "status": { "type": "string", "enum": ["PASS", "FAIL", "NOT_EXECUTED", "BLOCKED"] },
          "scope": { "type": "string" },
          "reason": { "type": "string" },
          "evidence": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "evaluation_debt": { "type": "array", "items": { "type": "string" } },
    "invariant_coverage": { "type": "number", "minimum": 0, "maximum": 1 },
    "example_preservation_rate": { "type": "number", "minimum": 0, "maximum": 1 },
    "output_contract_preserved": { "type": "boolean" },
    "critical_regressions": { "type": ["integer", "null"], "minimum": 0 },
    "manual_override": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["approver", "reason", "accepted_risks", "timestamp"],
      "properties": {
        "approver": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 },
        "accepted_risks": { "type": "string", "minLength": 1 },
        "timestamp": { "type": "string", "format": "date-time" }
      }
    }
  }
}
