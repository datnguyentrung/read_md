{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "OptimizationPlan",
  "title": "OptimizationPlan",
  "type": "object",
  "required": ["decision", "passes", "hard_invariants"],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["PLANNED", "NEEDS_REVIEW", "EXECUTING", "COMPLETED", "ROLLED_BACK"],
      "default": "PLANNED"
    },
    "decision": {
      "type": "string",
      "enum": ["KEEP", "LIGHT", "STRUCTURAL", "MAJOR", "EXTERNALIZE", "MODULARIZE"],
      "description": "Overall architectural optimization tier selected"
    },
    "passes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "enabled", "risk"],
        "properties": {
          "name": { "type": "string" },
          "enabled": { "type": "boolean" },
          "risk": { "type": "string", "enum": ["low", "medium", "high", "operational_high"] },
          "order": { "type": "integer" },
          "parameters": { "type": "object" },
          "rationale": { "type": "string" }
        }
      }
    },
    "hard_invariants": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Mandatory invariants that must be preserved (100% coverage required)"
    },
    "token_target": {
      "type": "object",
      "properties": {
        "max": { "type": ["integer", "null"] },
        "desired_reduction": { "type": ["number", "null"] }
      }
    }
  }
}
